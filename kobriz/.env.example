# ---------------------------------------------------------------------------
# kobriz ADLC configuration (EXAMPLE — placeholders only, never commit secrets)
# ---------------------------------------------------------------------------
# Copy to your shell profile / project env and fill in real values. These are
# read from the process environment by scripts/config.py. Claude Code does NOT
# auto-recognize these names; the plugin reads them explicitly.
#
# Required per mode:
#   mcp  -> ADLC_MCP_SERVER (+ the MCP server configured in .mcp.json/settings)
#   rest -> ADLC_TASK_API_BASE_URL, ADLC_TASK_API_TOKEN (unless AUTH_TYPE=none)
# Always useful: ADLC_REPOSITORY_ROOT, ADLC_BASE_BRANCH, ADLC_WORKTREE_ROOT
# ---------------------------------------------------------------------------

# --- Task source selection -------------------------------------------------
ADLC_TASK_SOURCE_TYPE=mcp              # mcp | rest

# --- MCP mode --------------------------------------------------------------
# Name of the MCP server (as configured for Claude Code) that exposes your task
# tools. The manager agent discovers the actual tool names/schemas at runtime.
ADLC_MCP_SERVER=

# --- REST mode -------------------------------------------------------------
ADLC_TASK_API_BASE_URL=               # e.g. https://your-task-service.example.com
ADLC_TASK_LIST_PATH=/tasks
ADLC_TASK_DETAILS_PATH=/tasks/{task_id}
ADLC_TASK_STATUS_PATH=/tasks/{task_id}/status
ADLC_TASK_COMMENT_PATH=               # optional, e.g. /tasks/{task_id}/comments
ADLC_TASK_LIST_METHOD=GET
ADLC_TASK_STATUS_METHOD=PATCH

# Subtask creation (used only after explicit user approval — see task-splitting skill).
ADLC_TASK_SUBTASK_PATH=               # create endpoint; defaults to ADLC_TASK_LIST_PATH
ADLC_TASK_SUBTASK_METHOD=POST
ADLC_TASK_PARENT_FIELD=parent_id      # body field linking a child to its parent story

# Auth: bearer | apikey | none
ADLC_TASK_AUTH_TYPE=bearer
ADLC_TASK_API_TOKEN=                   # PLACEHOLDER — provide via a secret manager
ADLC_TASK_API_KEY_HEADER=X-API-Key     # used only when AUTH_TYPE=apikey
ADLC_TASK_EXTRA_HEADERS_JSON={}        # e.g. {"X-Team":"core"}

# Map YOUR provider's field names -> kobriz canonical fields (id,title,
# description,status,acceptance_criteria,dependencies,kind,labels).
# Example: {"ticket_id":"id","summary":"title","blocked_by":"dependencies"}
ADLC_TASK_FIELD_MAP_JSON={}
# Map kobriz logical lifecycle states -> YOUR provider's status values.
# Example: {"IN_PROGRESS":"in-dev","COMPLETED":"done"}
ADLC_TASK_STATUS_MAP_JSON={}

# --- Git / worktree --------------------------------------------------------
ADLC_REPOSITORY_ROOT=                  # defaults to the current working directory
ADLC_BASE_BRANCH=main
ADLC_WORKTREE_ROOT=                    # defaults to <repo>-kobriz-worktrees next to the repo
ADLC_BRANCH_PREFIX=adlc

# --- Orchestration / merge policy -----------------------------------------
ADLC_MAX_CONCURRENCY=3
ADLC_MERGE_STRATEGY=merge              # merge | rebase | squash
ADLC_REQUIRE_TESTS=true
ADLC_AUTO_MERGE=false                  # keep false until safeguards are configured
ADLC_KEEP_FAILED_WORKTREES=true
ADLC_AUTO_RETRIES=0
